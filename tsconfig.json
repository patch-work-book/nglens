{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "lib": ["ES2020", "DOM"],
    "types": ["chrome"],
    "experimentalDecorators": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@nglens/types/*": ["src/types/*"],
      "@nglens/types": ["src/types"],
      "@nglens/utils/*": ["src/utils/*"],
      "@nglens/utils": ["src/utils"],
      "@nglens/analyzers/*": ["src/analyzers/*"],
      "@nglens/analyzers": ["src/analyzers"],
      "@nglens/instrumentation/*": ["src/instrumentation/*"]
    }
  },
  "include": ["src"]
}
